// Domain schema aligned with in-memory backend types (apps/backend/src/**).
// Change models here, then run: npm run db:migrate (from packages/database).

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum GroupRole {
  ADMIN
  MEMBER
}

enum ChatEntryType {
  LOG // A group event (generated by backend)
  ADM // Admin → all admins
  GEN // Admin → all admins and members
  MEM // Member → all admins
}

enum ChatEventKey {
  CREATE_GROUP
  JOIN_GROUP
  LEAVE_GROUP
  PROMOTE_ADMIN
  RESIGN_ADMIN
  RENAME_GROUP
  EXPEL_MEMBER
  DELETE_GROUP
  UPLOAD_VOCABULARY
  RENAME_VOCABULARY
  DELETE_VOCABULARY
  SET_ACTIVE_VOCABULARY
  SEND_INVITE
}

model User {
  id             Int      @id @default(autoincrement())
  name           String   @unique
  email          String   @unique
  password       String
  currentGroupId Int?
  createdAt      DateTime @default(now())
  realName                 String?
  relationshipComment      String?
  showRealName             Boolean  @default(false)
  showEmail                Boolean  @default(false)
  showRelationshipComment  Boolean  @default(false)

  currentGroup Group?            @relation("UserCurrentGroup", fields: [currentGroupId], references: [id], onDelete: SetNull)
  memberships  GroupMembership[]
  players      Player[]
  vocabularies Vocabulary[]
  chatEntries  GroupChatEntry[]
}

model Group {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())
  memberships  GroupMembership[]
  players      Player[]
  vocabularies Vocabulary[]
  currentVocabularyId Int? @unique
  currentVocabulary   Vocabulary? @relation("GroupCurrentVocabulary", fields: [currentVocabularyId], references: [id], onDelete: SetNull)
  games        Game[]
  invitations  Invitation[]
  currentUsers User[] @relation("UserCurrentGroup")
  chatEntries  GroupChatEntry[]
}

/// Replaces parallel admins[] / members[] on Group and isAdminOf / isMemberOf on User.
model GroupMembership {
  id      Int       @id @default(autoincrement())
  userId  Int
  groupId Int
  role    GroupRole @default(MEMBER)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
  @@index([groupId])
}

model Player {
  id            Int     @id @default(autoincrement())
  inGroupId     Int
  ofUserId      Int
  name          String
  passQuestion  String
  passAnswer    String
  currentGameId Int?
  lastSignout   DateTime @default(now())
  
  group          Group          @relation(fields: [inGroupId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [ofUserId], references: [id], onDelete: Cascade)
  currentGame    Game?          @relation("PlayerCurrentGame", fields: [currentGameId], references: [id], onDelete: SetNull)
  gamePlayers    GamePlayer[]
  initiatedGames Game[]         @relation("GameInitiator")
  session        PlayerSession?
}

/// One active browser session per player (Play Now). Orphaned tokens expire via expiresAt.
model PlayerSession {
  token     String   @id @default(uuid())
  playerId  Int      @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model Vocabulary {
  id        Int      @id @default(autoincrement())
  inGroupId Int
  byUserId  Int
  name      String
  words     String[]
  meanings  String[]
  wordCount Int      @default(0)
  createdAt DateTime @default(now())

  group Group @relation(fields: [inGroupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [byUserId], references: [id], onDelete: Cascade)
  currentForGroup Group? @relation("GroupCurrentVocabulary")

  @@index([inGroupId])
}

model Game {
  id            Int       @id @default(autoincrement())
  name          String
  inGroupId     Int
  initiatedById Int
  initiatedTime DateTime  @default(now())
  startedTime   DateTime?
  isActive      Boolean   @default(false)
  isFinished    Boolean   @default(false)

  group           Group        @relation(fields: [inGroupId], references: [id], onDelete: Cascade)
  initiatedBy     Player       @relation("GameInitiator", fields: [initiatedById], references: [id])
  gamePlayers     GamePlayer[]
  currentPlayers  Player[]     @relation("PlayerCurrentGame")
  crossword       Crossword?
}

model GamePlayer {
  gameId   Int
  playerId Int
  score    Int    @default(0)

  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@id([gameId, playerId])
}

model Crossword {
  id         Int     @id @default(autoincrement())
  gameId     Int     @unique
  rows       Int
  cols       Int
  solution   Json               // (string | null)[][] — NEVER sent to frontend
  playerGrid Json               // (string | null)[][] — current placed letters
  creditGrid Json?              // (number | null)[][] — first-correct-placer per cell
  clues      Json               // { across: ClueEntry[], down: ClueEntry[] }
  revision   Int     @default(0)
  solved     Boolean @default(false)

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
}

model Invitation {
  token     String   @id @default(uuid())
  groupId   Int
  createdAt DateTime @default(now())
  expiresAt DateTime
  used      Boolean  @default(false)

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
}

/// One entry in a group's permanent chat / event log.
/// entryNumber is per-group (starts at 1), assigned in a transaction by the service.
/// targetId is an untyped Int — its meaning is given by eventKey (can reference
/// any domain object: group, user, vocabulary, etc.). No FK enforced by Prisma.
model GroupChatEntry {
  groupId     Int
  entryNumber Int
  createdAt   DateTime      @default(now())
  type        ChatEntryType
  authorId    Int           // always a User
  authorName  String?       // stores author name at the time of entry
  targetId    Int?          // any domain object id, meaning given by eventKey
  targetName  String?       // name of above at time of entry
  eventKey    ChatEventKey? // null for ADM / GEN / MEM messages
  content     String?       // null for LOG entries

  group  Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  author User  @relation(fields: [authorId], references: [id])

  @@id([groupId, entryNumber])
  @@index([groupId]) // fast fetch of all entries for a group
}