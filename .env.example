# Copy values into apps/backend/.env and apps/frontend/.env for local dev.
# Docker Compose loads mail/auth secrets from apps/backend/.env automatically.
#
# Production: change JWT_SECRET, APP_URL, and NEXT_PUBLIC_* to your public domain.

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/transcendence
JWT_SECRET=supersecret

# Backend (apps/backend/.env for local Nest + Docker env_file)
OPENAI_API_KEY=

# Backend mail & invitations (Gmail app password)
MAIL_USER=dictee.app@gmail.com
MAIL_PASS=your-gmail-app-password
MAIL_FROM=dictee.app@gmail.com
APP_URL=http://localhost:3000

# Frontend (apps/frontend/.env for local Next)
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
