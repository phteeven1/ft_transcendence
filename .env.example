# no .env in root, only .env.example. This is to avoid committing secrets to git.
# Root / Docker Compose — copy to .env if you customize defaults.
# JWT needs to be changed before production, otherwise the default value will be used.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/transcendence
JWT_SECRET=supersecret

# Backend (apps/backend/.env for local Nest)
OPENAI_API_KEY=

# Backend mail & invitations
MAIL_USER=dictee.app@gmail.com
MAIL_PASS=(get this password from tsternbe)
MAIL_FROM=dictee.app@gmail.com
APP_URL=http://localhost:3000

# Frontend (apps/frontend/.env for local Next)
NEXT_PUBLIC_APP_URL=http://localhost:3000
