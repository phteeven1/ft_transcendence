# Copy into:
#   packages/database/.env  — DATABASE_URL
#   apps/backend/.env       — DATABASE_URL, OPENAI_API_KEY, MAIL_*, APP_URL
#   apps/frontend/.env      — NEXT_PUBLIC_*
#
# Docker Compose loads apps/backend/.env for mail and OpenAI.
# Leave OPENAI_API_KEY empty if you are not using AI vocab import.

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/transcendence

OPENAI_API_KEY=

MAIL_USER=your-gmail@example.com
MAIL_PASS=your-gmail-app-password
MAIL_FROM=your-gmail@example.com
APP_URL=http://localhost:3000

NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
